---
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const fullTitle = title.endsWith(' | Binary Brains')
  ? title
  : `${title.trim()} | Binary Brains`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="resources-hub/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
